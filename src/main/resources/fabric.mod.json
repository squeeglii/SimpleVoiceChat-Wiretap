{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_title}",
  "description": "Adds microphones & speakers to simple voice chat.",
  "authors": [
    "Max Henkel",
    "Will Scully"
  ],
  "contact": {
    "discord": "https://discord.gg/94c45XagEH"
  },
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.maxhenkel.wiretap.Wiretap"
    ],
    "voicechat": [
      "de.maxhenkel.wiretap.WiretapVoicechatPlugin"
    ]
  },
  "mixins": [
    "wiretap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_dependency}",
    "java": ">=25",
    "voicechat": ">=${voicechat_api_version}+${minecraft_dependency}"
  },
  "breaks": {
    "fabric-api": "<${fabric_api_version}"
  }
}
